# Copy to `.env` and fill in. `.env` is gitignored.
#
#   cp .env.example .env
#
# Real environment variables take precedence over this file, so you can
# override for a single command:
#
#   ANTHROPIC_API_KEY=sk-other uv run mistara extract ...

# The only provider currently implemented.
ANTHROPIC_API_KEY=

# Not yet wired up — clients for these still need writing.
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
